FROM node:18-alpine AS builder
WORKDIR /app

# Копируем только нужные файлы
COPY knitted_toys_store/package*.json ./
RUN npm install

# Убедись, что .env.local не попадёт
COPY knitted_toys_store/ ./
RUN rm -f .env.local  # критично!

# Собираем Next.js
RUN npm run build

# Production stage
FROM node:18-alpine AS runner
WORKDIR /app

# Копируем собранный проект
COPY --from=builder /app ./

# Только продакшн-зависимости
RUN npm install --omit=dev

EXPOSE 3000
CMD ["npm", "start"]